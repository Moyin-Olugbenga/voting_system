datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

enum ElectionStatus {
  DRAFT
  READY
  ACTIVE
  CLOSED
}

model Admin {
  id           String      @id @default(uuid())
  username     String      @unique
  passwordHash String
  role         Role        @default(ADMIN)
  createdAt    DateTime    @default(now())
  auditLogs    AuditLog[]
}

model Device {
  id           String      @id @default(uuid())
  name         String
  deviceKey    String      @unique
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  voters       Voter[]
}

model Voter {
  id            String             @id
  name          String
  fingerprintId Int
  deviceId      String
  device        Device             @relation(fields: [deviceId], references: [id])
  createdAt     DateTime           @default(now())
  eligibility   VoterEligibility[]
  participation VoterParticipation[]
  sessions      VotingSession[]

  @@unique([deviceId, fingerprintId])
}

model Election {
  id            String             @id @default(uuid())
  title         String
  status        ElectionStatus     @default(DRAFT)
  createdAt     DateTime           @default(now())
  candidates    Candidate[]
  eligibility   VoterEligibility[]
  sessions      VotingSession[]
  participation VoterParticipation[]
  ballots       Ballot[]
}

model Candidate {
  id          Int      @id @default(autoincrement())
  electionId  String
  election    Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  name        String
}

model VoterEligibility {
  electionId String
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  voterId    String
  voter      Voter    @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@id([electionId, voterId])
}

model VotingSession {
  id         String   @id @default(uuid())
  electionId String
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  voterId    String
  voter      Voter    @relation(fields: [voterId], references: [id], onDelete: Cascade)
  token      String   @unique
  expiresAt  DateTime
  isUsed     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model VoterParticipation {
  id             String   @id @default(uuid())
  electionId     String
  election       Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  voterId        String
  voter          Voter    @relation(fields: [voterId], references: [id], onDelete: Cascade)
  participatedAt DateTime @default(now())

  @@unique([electionId, voterId])
}

model Ballot {
  id          String   @id @default(uuid())
  electionId  String
  election    Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidateId Int
  castAt      DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  adminId   String?
  admin     Admin?   @relation(fields: [adminId], references: [id])
  action    String
  details   Json?
  timestamp DateTime @default(now())
}